  "captions": [
    {
      "start": 1.2,
      "end": 7,
      "text": "In a quiet meadow, under a silver moon…"
    },
    {
      "start": 7.4,
      "end": 11.4,
      "text": "lived a little firefly named Lumi."
    },
    {
      "start": 16.8,
      "end": 20.4,
      "text": "One night, a star slipped out of the sky."
    },
    {
      "start": 20.7,
      "end": 24.2,
      "text": "It landed with a bump."
    },
    {
      "start": 25.3,
      "end": 30.6,
      "text": "The star was far too heavy for one little bug."
    },
    {
      "start": 31.9,
      "end": 35.7,
      "text": "So Lumi called her friends."
    },
    {
      "start": 37.4,
      "end": 42.2,
      "text": "Together, they lifted it higher…"
    },
    {
      "start": 42.6,
      "end": 47.3,
      "text": "…higher than the tallest tree."
    },
    {
      "start": 50.9,
      "end": 55.9,
      "text": "And the sky lit up like a smile."
    },
    {
      "start": 62.4,
      "end": 66,
      "text": "Goodnight, little star."
    }
  ],

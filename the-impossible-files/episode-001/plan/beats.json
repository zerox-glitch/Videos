 "captions": {
  "s1": [
   {
    "text": "It was just",
    "hi": false,
    "t": 0.45,
    "t1": 1.59
   },
   {
    "text": "a black cube.",
    "hi": false,
    "t": 1.45,
    "t1": 2.78
   },
   {
    "text": "Ten centimeters wide.",
    "hi": true,
    "t": 2.64,
    "t1": 4.69
   },
   {
    "text": "No buttons.",
    "hi": false,
    "t": 4.55,
    "t1": 5.69
   },
   {
    "text": "No openings.",
    "hi": false,
    "t": 5.55,
    "t1": 6.78
   },
   {
    "text": "Nothing unusual.",
    "hi": false,
    "t": 6.64,
    "t1": 8.24
   }
  ],
  "s2": [
   {
    "text": "Until someone tried",
    "hi": false,
    "t": 11.48,
    "t1": 13.14
   },
   {
    "text": "to measure what was inside.",
    "hi": false,
    "t": 13.0,
    "t1": 15.3
   },
   {
    "text": "The scanner detected",
    "hi": false,
    "t": 15.16,
    "t1": 16.9
   },
   {
    "text": "an empty room...",
    "hi": false,
    "t": 16.76,
    "t1": 18.19
   },
   {
    "text": "Nearly a kilometer long.",
    "hi": true,
    "t": 18.05,
    "t1": 20.11
   },
   {
    "text": "That should have been",
    "hi": false,
    "t": 19.97,
    "t1": 21.79
   },
   {
    "text": "impossible.",
    "hi": false,
    "t": 21.65,
    "t1": 22.67
   }
  ],
  "s3": [
   {
    "text": "So they sent",
    "hi": false,
    "t": 23.61,
    "t1": 25.1
   },
   {
    "text": "a miniature camera",
    "hi": false,
    "t": 24.96,
    "t1": 27.13
   },
   {
    "text": "through its surface.",
    "hi": false,
    "t": 26.99,
    "t1": 29.39
   },
   {
    "text": "On the other side",
    "hi": false,
    "t": 29.25,
    "t1": 31.31
   },
   {
    "text": "was a hallway.",
    "hi": false,
    "t": 31.17,
    "t1": 32.89
   },
   {
    "text": "Massive pillars.",
    "hi": false,
    "t": 32.75,
    "t1": 34.69
   },
   {
    "text": "A ceiling lost in darkness.",
    "hi": false,
    "t": 34.55,
    "t1": 37.74
   },
   {
    "text": "And at the far end...",
    "hi": false,
    "t": 37.6,
    "t1": 40.11
   },
   {
    "text": "Another black cube.",
    "hi": true,
    "t": 39.97,
    "t1": 42.25
   }
  ],
  "s4": [
   {
    "text": "The camera entered it.",
    "hi": false,
    "t": 43.33,
    "t1": 46.55
   },
   {
    "text": "Another hallway.",
    "hi": false,
    "t": 46.41,
    "t1": 48.79
   },
   {
    "text": "Ten times larger.",
    "hi": true,
    "t": 48.65,
    "t1": 51.17
   },
   {
    "text": "Then another cube.",
    "hi": false,
    "t": 51.03,
    "t1": 53.69
   },
   {
    "text": "And another.",
    "hi": false,
    "t": 53.55,
    "t1": 55.37
   },
   {
    "text": "Each one led",
    "hi": false,
    "t": 55.23,
    "t1": 57.05
   },
   {
    "text": "to a world",
    "hi": false,
    "t": 56.91,
    "t1": 58.45
   },
   {
    "text": "bigger than the last.",
    "hi": false,
    "t": 58.31,
    "t1": 61.39
   }
  ],
  "s5": [
   {
    "text": "But after",
    "hi": false,
    "t": 63.2,
    "t1": 64.19
   },
   {
    "text": "the seventh cube...",
    "hi": true,
    "t": 64.05,
    "t1": 65.98
   },
   {
    "text": "Something changed.",
    "hi": false,
    "t": 65.84,
    "t1": 67.68
   },
   {
    "text": "The camera entered",
    "hi": false,
    "t": 67.54,
    "t1": 69.38
   },
   {
    "text": "a room it recognized.",
    "hi": false,
    "t": 69.24,
    "t1": 71.36
   },
   {
    "text": "The same walls.",
    "hi": false,
    "t": 71.22,
    "t1": 72.77
   },
   {
    "text": "The same table.",
    "hi": false,
    "t": 72.63,
    "t1": 74.19
   }
  ],
  "s6": [
   {
    "text": "The same laboratory",
    "hi": true,
    "t": 78.36,
    "t1": 80.05
   },
   {
    "text": "where the experiment began.",
    "hi": false,
    "t": 79.91,
    "t1": 82.25
   },
   {
    "text": "And on that table...",
    "hi": false,
    "t": 82.11,
    "t1": 83.88
   },
   {
    "text": "Sat a black cube.",
    "hi": false,
    "t": 83.73,
    "t1": 85.26
   },
   {
    "text": "Then the researchers noticed",
    "hi": false,
    "t": 85.12,
    "t1": 87.54
   },
   {
    "text": "something terrifying.",
    "hi": false,
    "t": 87.4,
    "t1": 89.25
   }
  ],
  "s7": [
   {
    "text": "On their monitor...",
    "hi": false,
    "t": 90.45,
    "t1": 92.37
   },
   {
    "text": "They could see themselves",
    "hi": false,
    "t": 92.23,
    "t1": 94.72
   },
   {
    "text": "watching the camera feed.",
    "hi": false,
    "t": 94.58,
    "t1": 97.06
   },
   {
    "text": "But behind them,",
    "hi": false,
    "t": 96.92,
    "t1": 98.56
   },
   {
    "text": "standing in the laboratory...",
    "hi": false,
    "t": 98.42,
    "t1": 101.28
   },
   {
    "text": "Was the camera.",
    "hi": true,
    "t": 101.14,
    "t1": 102.69
   }
  ],
  "s8": [
   {
    "text": "It hadn't traveled deeper",
    "hi": false,
    "t": 103.62,
    "t1": 105.12
   },
   {
    "text": "into the cube.",
    "hi": false,
    "t": 104.98,
    "t1": 105.88
   },
   {
    "text": "It had somehow",
    "hi": false,
    "t": 105.74,
    "t1": 106.65
   },
   {
    "text": "come back out.",
    "hi": true,
    "t": 106.51,
    "t1": 107.41
   }
  ]
 },

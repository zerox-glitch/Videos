 "vo": {
  "hook": {
   "t": 2.2,
   "text": "This is Stickman. He is completely fine."
  },
  "p1": {
   "t": 13.25,
   "text": "He once hit snooze so hard, he woke up in a museum."
  },
  "p2": {
   "t": 24.95,
   "text": "His blood type is espresso."
  },
  "p3": {
   "t": 37.3,
   "text": "This meeting could have been an email. The email could have been a thought."
  },
  "p4": {
   "t": 49.35,
   "text": "He told his smartwatch he ran a marathon. The watch believed him. Neither of them moved."
  },
  "p5": {
   "t": 61.7,
   "text": "Turns out, the only one who ever listened was rubber."
  },
  "outro": {
   "t": 67.35,
   "text": "Stickman insists he is fine. The coffee agrees."
  },
  "boss": {
   "t": 30.1,
   "text": "Quick five minute meeting!"
  }
 },
